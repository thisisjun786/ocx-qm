# Optional configuration. Copy to .env, then:
# node --env-file=.env src/server.mjs
# npm start does not automatically load this file.
QUOTA_HOST=127.0.0.1
QUOTA_PORT=8787
# Use absolute paths; environment files do not expand ~ or $HOME.
# OPENCODEX_HOME=/absolute/path/to/.opencodex
# QUOTA_DATA_DIR=/absolute/path/to/private/quota-monitor
# Set this to your existing OCX management listener, not the inference listener.
# QUOTA_OPENCODEX_ORIGIN=http://127.0.0.1:10104
# Optional Tailscale Serve HTTPS origin; keep backend QUOTA_HOST=127.0.0.1.
# QUOTA_PUBLIC_ORIGIN=https://your-machine.your-tailnet.ts.net
